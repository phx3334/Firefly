---
import type { GetStaticPaths } from "astro";
import { Icon } from "astro-icon/components";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import PostCard from "@/components/layout/PostCard.astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getCategoryList, getSortedPosts } from "@/utils/content-utils";
import { getPostUrlBySlug, url } from "@/utils/url-utils";

export const getStaticPaths = (async () => {
	const categories = await getCategoryList();
	const allPosts = await getSortedPosts();
	const uncategorizedName = i18n(I18nKey.uncategorized).trim().toLowerCase();

	return categories.map((cat) => {
		const name = cat.name.trim();
		const isUncategorized = name.toLowerCase() === uncategorizedName;
		const posts = allPosts.filter((p) => {
			const c = (p.data.category || "").trim();
			return isUncategorized ? c === "" : c === name;
		});
		return {
			params: { category: name },
			props: { categoryName: name, posts, count: cat.count },
		};
	});
}) satisfies GetStaticPaths;

interface Props {
	categoryName: string;
	posts: Awaited<ReturnType<typeof getSortedPosts>>;
	count: number;
}

const { categoryName, posts, count } = Astro.props;
---

<MainGridLayout title={categoryName}>
    <!-- 分类页头 -->
    <div class="card-base px-8 py-6 mb-4 onload-animation">
        <a
            href={url("/categories/")}
            class="inline-flex items-center gap-1 text-sm text-30 hover:text-(--primary) transition-colors mb-3"
        >
            <Icon is:inline name="material-symbols:chevron-left-rounded" class="text-lg" />
            {i18n(I18nKey.categories)}
        </a>
        <div class="flex items-center gap-3">
            <div class="shrink-0 w-12 h-12 rounded-xl bg-(--primary)/10 flex items-center justify-center">
                <Icon is:inline name="material-symbols:folder-open" class="text-2xl text-(--primary)" />
            </div>
            <div>
                <h1 class="text-2xl font-bold text-90">{categoryName}</h1>
                <p class="text-sm text-30 mt-0.5">{count} {i18n(I18nKey.postsCount)}</p>
            </div>
        </div>
    </div>

    <!-- 该分类的文章列表 -->
    <div class="flex flex-col gap-4">
        {posts.map((entry, index) => (
            <PostCard
                entry={entry}
                title={entry.data.title}
                tags={entry.data.tags}
                category={entry.data.category}
                published={entry.data.published}
                updated={entry.data.updated}
                url={getPostUrlBySlug(entry.id)}
                image={entry.data.image}
                description={entry.data.description}
                draft={entry.data.draft}
                pinned={entry.data.pinned}
                password={!!entry.data.password}
                class:list="onload-animation"
                style={`animation-delay: calc(var(--content-delay) + ${index * 50}ms)`}
            />
        ))}
    </div>
</MainGridLayout>
